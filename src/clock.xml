<?xml version="1.0"?>
<wf-panel-pi>
  <plugin name="clock">
	<group>
	  <option name="time_format" type="string">
		<default>%R</default>
	  </option>
	  <option name="date_format" type="string">
		<default>%A %x</default>
	  </option>
	  <option name="font" type="string">
		<default>default</default>
	  </option>
	  <option name="custom_font" type="bool">
		<default>false</default>
	  </option>
	  <option name="analogue" type="bool">
		<default>false</default>
	  </option>
	  <option name="face_col" type="string">
		<default>white</default>
	  </option>
	  <option name="hands_col" type="string">
		<default>black</default>
	  </option>
	</group>
  </plugin>
</wf-panel-pi>
